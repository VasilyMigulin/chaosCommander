  m_TableData:
  - m_Id: 247227998208
    m_Localized: "\u0417\u0430 \u0440\u0430\u0431\u043E\u0442\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718464
    m_Localized: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0445\u043E\u0434\u0430:
      \u0432\u0430\u0448\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
      +*1* \u043A \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718465
    m_Localized: "\u041C\u043E\u043B\u0438\u0442\u0432\u0430 \u0437\u0430 \u0437\u0434\u0440\u0430\u0432\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718466
    m_Localized: "\u0412\u0430\u0448\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 +*2* \u043A \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718467
    m_Localized: "\u041D\u0430\u0441\u0442\u0443\u043F\u0430\u044E\u0449\u0438\u0439
      \u043A\u0440\u0438\u0437\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718468
    m_Localized: "\u041E\u0431\u0430 \u0438\u0433\u0440\u043E\u043A\u0430 \u0432
      \u043D\u0430\u0447\u0430\u043B\u0435 \u0445\u043E\u0434\u0430 \u043D\u0435
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0437\u043E\u043B\u043E\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718469
    m_Localized: "\u0412\u0435\u0440\u0431\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718470
    m_Localized: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0445\u043E\u0434\u0430:
      \u043F\u0440\u0438\u0437\u043E\u0432\u0438\u0442\u0435 2 \u0411\u043E\u0439\u0446\u043E\u0432
      \u043D\u0430 \u0430\u0440\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718471
    m_Localized: "\u0414\u043E\u043B\u0433\u0438\u0439 \u043E\u0431\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718472
    m_Localized: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0445\u043E\u0434\u0430:
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 *3* \u0443\u0440\u043E\u043D\u0430
      \u0438 *2* \u043C\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912768
    m_Localized: "\u041F\u043E\u0437\u0432\u0430\u0442\u044C \u0431\u0430\u0442\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912769
    m_Localized: "\u041F\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0438:
      \u043F\u0440\u0438\u0437\u043E\u0432\u0438\u0442\u0435 \u0411\u0430\u0442\u044E
      10/10"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912770
    m_Localized: "\u041F\u043E\u0436\u0430\u0440\u0438\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912771
    m_Localized: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0445\u043E\u0434\u0430:
      \u0432\u0441\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u043F\u043E
      *2* \u0443\u0440\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912772
    m_Localized: "\u041F\u043B\u043E\u0445\u0430\u044F \u043F\u043E\u0433\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912773
    m_Localized: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u043E\u043F\u043F\u043E\u043D\u0435\u043D\u0442\u0430
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 -*1* \u043A \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912774
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u043E\u0435 \u043E\u0442\u043B\u0443\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912775
    m_Localized: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u043E\u043F\u043F\u043E\u043D\u0435\u043D\u0442\u0430
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 -*3* \u043A \u0430\u0442\u0430\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912776
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u043E\u0435 \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912777
    m_Localized: "\u0412\u0441\u0435 \u0432\u0430\u0448\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0436\u0451\u043B\u0442\u044B\u0439
      \u0446\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912778
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0433\u043E\u0432\u0435\u0439\u043D\u044B\u0439
      \u043F\u0440\u0438\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912779
    m_Localized: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0432\u0430\u0448\u0435\u0433\u043E
      \u0445\u043E\u0434\u0430 \u0432\u0430\u0448\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 +*2*/+*3*"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912780
    m_Localized: "\u0427\u0451\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912781
    m_Localized: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u0445\u043E\u0434\u0430:
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442 *1* \u0443\u0440\u043E\u043D\u0430
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u043C\u0443 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912782
    m_Localized: "\u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0447\u0451\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912783
    m_Localized: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u0445\u043E\u0434\u0430:
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442 *2* \u0443\u0440\u043E\u043D\u0430
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u043C\u0443 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912784
    m_Localized: "\u0413\u043B\u0430\u0432\u0430\u0440\u044C \u0447\u0451\u0440\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912785
    m_Localized: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u0445\u043E\u0434\u0430:
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0435
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912786
    m_Localized: "\u0413\u043B\u0430\u0432\u0430\u0440\u044C \u043F\u0440\u0435\u0438\u0441\u043F\u043E\u0434\u043D\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912787
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u043D\u0438\u0438:
      \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0432\u0430\u0448\u0443
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0447\u0435\u0440\u0442\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912788
    m_Localized: "\u0413\u0440\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912789
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u043D\u0438\u0438:
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 +*1*/+*1* \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0447\u0451\u0440\u0442\u0430, \u043F\u0440\u0438\u0437\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0432\u0430\u043C\u0438 \u0432 \u044D\u0442\u043E\u043C \u043C\u0430\u0442\u0447\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912790
    m_Localized: "\u0413\u043E\u043B\u0443\u0431\u043E\u0439 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912791
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u043D\u0438\u0438:
      \u0434\u0430\u0451\u0442 *3* \u043C\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912792
    m_Localized: "\u041D\u0435\u0443\u0434\u0430\u0447\u043B\u0438\u0432\u044B\u0439
      \u0447\u0430\u0440\u043E\u0434\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912793
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u043D\u0438\u0438:
      \u0442\u0440\u0430\u0442\u0438\u0442 2 \u043C\u0430\u043D\u044B, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0430\u043D\u0435\u0441\u0442\u0438 *3* \u0443\u0440\u043E\u043D\u0430
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430\u043C \u043E\u043F\u043F\u043E\u043D\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912794
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u043E\u043B\u0434\u0443\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912795
    m_Localized: "\u0413\u043D\u0438\u0434\u0430\u043B\u044C\u0444 \u043D\u0435\u043C\u044B\u0442\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912796
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u043D\u0438\u0438:
      \u0437\u0430\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442 \u0432 \u043A\u043E\u043B\u043E\u0434\u0443
      \u043E\u043F\u043F\u043E\u043D\u0435\u043D\u0442\u0430 \u0412\u043E\u043D\u044E\u0447\u0435\u0435
      \u043E\u0431\u043B\u0430\u043A\u043E \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435
      \u0437\u0430\u043C\u0435\u0448\u0430\u043D\u043D\u043E\u0435 \u0432\u0430\u043C\u0438
      \u0432 \u044D\u0442\u043E\u043C \u043C\u0430\u0442\u0447\u0435 \u0412\u043E\u043D\u044E\u0447\u0435\u0435
      \u043E\u0431\u043B\u0430\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912797
    m_Localized: "\u0420\u0430\u0431\u043E\u0442\u044F\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912798
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u043D\u0438\u0438:
      \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u0435\u0442 \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u0440\u0430\u0431\u043E\u0442\u044F\u0433\u0443 \u0438\u0437 \u043A\u043E\u043B\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912799
    m_Localized: "\u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A \u0441\u043C\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912800
    m_Localized: "\u041F\u043E\u043A\u0430 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u0442\u0435:
      \u0432\u0430\u0448\u0438 \u0440\u0430\u0431\u043E\u0442\u044F\u0433\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
      +*1*/+*2*"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912801
    m_Localized: "\u041F\u0440\u043E\u0440\u0430\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912802
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u043D\u0438\u0438:
      \u0437\u0430\u043C\u0435\u0448\u0430\u0439\u0442\u0435 2 \u0420\u0430\u0431\u043E\u0442\u044F\u0433
      \u0432 \u043A\u043E\u043B\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912803
    m_Localized: "\u0411\u043E\u0435\u0446 \u043D\u0430 \u0430\u0440\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912804
    m_Localized: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0445\u043E\u0434\u0430:
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 +*1* \u043A \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912805
    m_Localized: "\u041C\u0430\u0433-\u043F\u0438\u0440\u043E\u043C\u0430\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912806
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u043D\u0438\u0438:
      \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u0440\u0443\u043A\u0443
      \u041F\u043E\u0434\u0436\u043E\u0433\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912807
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 \u0441\u0430\u0442\u0430\u043D\u0438\u0441\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912808
    m_Localized: "\u041F\u0440\u0438 \u0441\u043C\u0435\u0440\u0442\u0438: \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442
      \u0432\u0430\u0448\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912809
    m_Localized: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912810
    m_Localized: "\u041F\u0440\u0438 \u0441\u043C\u0435\u0440\u0442\u0438: \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      *2* \u0443\u0440\u043E\u043D\u0430 \u043E\u0431\u043E\u0438\u043C \u0438\u0433\u0440\u043E\u043A\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912811
    m_Localized: "\u041D\u0430\u0447\u0438\u0442\u0430\u043D\u043D\u044B\u0439 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0438\u043A
      \u041F\u043E\u043F\u0430\u0434\u043E\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 247290912812
