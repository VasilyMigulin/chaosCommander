      \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E
      \u0432 \u0440\u0443\u043A\u0443, \u043E\u043D\u0430 \u0441\u0442\u043E\u0438\u0442
      \u043D\u0430 1 \u043C\u0435\u043D\u044C\u0448\u0435 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u043B\u0438
      \u044D\u0442\u0443 \u043A\u0430\u0440\u0442\u0443"
