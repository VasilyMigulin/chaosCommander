  - m_Id: 8718668325183491
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 Apple"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183492
    m_Localized: "\u0441\u043A\u043E\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183493
    m_Localized: "\u041D\u0438\u043A \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      (\u043C\u0438\u043D. 3)"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183494
    m_Localized: "\u042D\u0442\u043E \u0438\u043C\u044F \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E
      \u2014 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0434\u0440\u0443\u0433\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183495
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0434\u0430\u0442\u044C
      \u043D\u0438\u043A \u2014 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0435\u0449\u0451 \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183496
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183497
    m_Localized: "\u041A\u043E\u043D\u0435\u0446 \u0445\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183498
    m_Localized: "\u0418\u0449\u0435\u043C \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183499
    m_Localized: "\u0421\u0442\u0443\u0447\u0438\u043C\u0441\u044F \u0432 \u0441\u0435\u0440\u0432\u0435\u0440\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183500
    m_Localized: "\u0411\u0443\u0434\u0438\u043C \u0430\u0434\u043C\u0438\u043D\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183501
    m_Localized: "\u041F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0447\u0435\u0440\u0435\u0434\u044C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183502
    m_Localized: "\u041F\u0440\u043E\u0442\u0438\u0440\u0430\u0435\u043C \u043F\u044B\u043B\u044C
      \u0441 \u0431\u0430\u0437\u044B \u0434\u0430\u043D\u043D\u044B\u0445\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183503
    m_Localized: "\u041F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u043C
      \u0432\u0430\u0448\u0438 \u0431\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183504
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C, \u043D\u0435
      \u0441\u0431\u0435\u0436\u0430\u043B \u043B\u0438 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183505
    m_Localized: "\u0418\u0449\u0435\u043C \u0432\u0430\u0448 \u0430\u043A\u043A\u0430\u0443\u043D\u0442
      \u0432 \u0441\u0442\u043E\u043F\u043A\u0435\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183506
    m_Localized: "\u0423\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u043C
      \u0441\u0435\u0440\u0432\u0435\u0440 \u043F\u0443\u0441\u0442\u0438\u0442\u044C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183507
    m_Localized: "\u0420\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C
      \u043A\u0430\u0440\u0442\u044B \u043F\u043E \u043C\u0435\u0441\u0442\u0430\u043C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183508
    m_Localized: "\u0418\u0449\u0435\u043C \u0440\u043E\u0437\u0435\u0442\u043A\u0443
      \u0434\u043B\u044F \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8718668325183509
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u043C\u0441\u044F
      \u0441 \u043E\u0431\u043B\u0430\u043A\u043E\u043C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8723275818459136
    m_Localized: "\u042D\u0442\u043E \u0442\u0432\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440.
      \u0412\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0439
      \u2014 \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u044F\u0439 \u043A\u043E\u0433\u0434\u0430
      \u0432\u0437\u0434\u0443\u043C\u0430\u0435\u0442\u0441\u044F. \u041F\u0440\u0438\u043A\u043E\u043D\u0447\u0430\u0442
      \u2014 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u0445\u043E\u0434, \u0437\u043B\u043E\u0439 \u0438 \u0441 \u043F\u0440\u0435\u0442\u0435\u043D\u0437\u0438\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 8723275856207872
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u0438\u0448\u043A\u043E. \u0417\u0430
      \u043D\u0435\u0433\u043E \u043D\u0430 \u0441\u0442\u043E\u043B \u0432\u044B\u0445\u043E\u0434\u044F\u0442
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430. \u0412 \u043D\u0430\u0447\u0430\u043B\u0435
      \u0445\u043E\u0434\u0430 \u0435\u0433\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0438 \u043E\u043D\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u2014 \u043A\u043E\u043F\u0438\u0442\u044C \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E,
      \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 8723275856207873
    m_Localized: "\u0422\u0430\u0449\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E
      \u0438\u0437 \u0440\u0443\u043A\u0438 \u043D\u0430 \u0441\u0432\u043E\u044E
      \u043F\u0435\u0440\u0435\u0434\u043D\u044E\u044E \u043B\u0438\u043D\u0438\u044E.
      \u0417\u043E\u043B\u043E\u0442\u0438\u0448\u043A\u0430 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u2014 \u043D\u0435 \u0436\u043C\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 8723275856207874
    m_Localized: "\u0423 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0442\u0440\u0438
      \u0447\u0438\u0441\u043B\u0430. \u0410\u0442\u0430\u043A\u0430 \u2014 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043E\u0442\u0441\u044B\u043F\u0435\u0442. \u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435
      \u2014 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0435\u0440\u043F\u0438\u0442.
      \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u2014 \u0432\u043E\u0442
      \u0442\u0443\u0442 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 8723275856207875
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u2014 \u044D\u0442\u043E
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F, \u0430 \u043D\u0435 \u0431\u0435\u0433.
      \u0428\u0430\u0433 \u0441\u0442\u043E\u0438\u0442 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438,
      \u0443\u0434\u0430\u0440 \u2014 \u0442\u043E\u0436\u0435. \u0411\u0438\u0442\u044C
      \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0437 \u0437\u0430 \u0445\u043E\u0434.
      \u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0445\u043E\u0434\u0430 \u0432\u0441\u0451
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 8723275856207876
    m_Localized: "\u041A\u043B\u0438\u043A\u043D\u0438 \u0441\u0432\u043E\u0451 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E,
      \u043F\u043E\u0442\u043E\u043C \u0441\u043E\u0441\u0435\u0434\u043D\u044E\u044E
      \u043A\u043B\u0435\u0442\u043A\u0443. \u0428\u0430\u0433 \u0442\u0440\u0430\u0442\u0438\u0442
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C: \u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C
      \u2014 \u0437\u0430\u0432\u0435\u0440\u0448\u0438 \u0445\u043E\u0434, \u0438
      \u043E\u043D\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 8723275856207877
    m_Localized: "\u0414\u043E\u0439\u0434\u0438 \u0434\u043E \u0447\u0443\u0436\u043E\u0433\u043E
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0438 \u0432\u0434\u0430\u0440\u044C:
      \u043A\u043B\u0438\u043A \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443,
      \u043A\u043B\u0438\u043A \u043F\u043E \u0432\u0440\u0430\u0433\u0443 \u0440\u044F\u0434\u043E\u043C.
      \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E
      \u2014 \u0437\u0430\u0432\u0435\u0440\u0448\u0438 \u0445\u043E\u0434 \u0438
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 8723275856207878
    m_Localized: "\u0421 \u0442\u0440\u0443\u043F\u0430 \u043A\u0430\u043F\u043D\u0443\u043B\u0430
      \u043C\u0430\u043D\u0430. \u041E\u043D\u0430 \u043D\u0443\u0436\u043D\u0430
      \u0434\u043B\u044F \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439
      \u0438 \u0447\u0430\u0440. \u0421\u0430\u043C\u0430 \u043D\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u2014 \u0434\u043E\u0431\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0438\u0437
      \u0447\u0443\u0436\u0438\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432 \u0438\u043B\u0438
      \u0440\u0430\u0437\u043D\u044B\u043C\u0438 \u0445\u0438\u0442\u0440\u043E\u0441\u0442\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 8723275856207879
    m_Localized: "\u041C\u0430\u043D\u0430 \u0435\u0441\u0442\u044C \u2014 \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u0439
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435. \u0423 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439
      \u0431\u044B\u0432\u0430\u044E\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F:
      \u043D\u0435\u0442 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0439
      \u0446\u0435\u043B\u0438 \u2014 \u043D\u0435 \u0441\u044B\u0433\u0440\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 8723275856207880
    m_Localized: "\u0415\u0449\u0451 \u0431\u044B\u0432\u0430\u044E\u0442 \u0447\u0430\u0440\u044B
      \u2014 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u0448\u0442\u0443\u043A\u0438,
      \u0442\u043E\u0436\u0435 \u0437\u0430 \u043C\u0430\u043D\u0443. \u0411\u043E\u043B\u044C\u0448\u0435
      \u043F\u044F\u0442\u0438 \u043F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C
      \u043D\u0435 \u0443\u0434\u0435\u0440\u0436\u0438\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 8723275856207881
    m_Localized: "\u0424\u0438\u043D\u0430\u043B. \u041F\u0440\u043E\u0431\u0435\u0439\u0441\u044F
      \u043A \u0430\u0432\u0430\u0442\u0430\u0440\u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
      \u0438 \u043A\u043E\u043B\u043E\u0442\u0438, \u043F\u043E\u043A\u0430 \u043D\u0435
      \u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F. \u041A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u2014 \u0437\u0430\u0432\u0435\u0440\u0448\u0438
      \u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 8723275856207882
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
