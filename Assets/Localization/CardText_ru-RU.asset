  m_TableData:
  - m_Id: 247227998208
    m_Localized: "\u0417\u0430 \u0440\u0430\u0431\u043E\u0442\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718464
    m_Localized: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0445\u043E\u0434\u0430:
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u043F\u043E\u0434 \u0432\u0430\u0448\u0438\u043C
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
      +*1* \u043A \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718465
    m_Localized: "\u041C\u043E\u043B\u0438\u0442\u0432\u0430 \u0437\u0430 \u0437\u0434\u0440\u0430\u0432\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718466
    m_Localized: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u043F\u043E\u0434
      \u0432\u0430\u0448\u0438\u043C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 +*2* \u043A \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718467
    m_Localized: "\u041D\u0430\u0441\u0442\u0443\u043F\u0430\u044E\u0449\u0438\u0439
      \u043A\u0440\u0438\u0437\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 247286718468
    m_Localized: "\u041E\u0431\u0430 \u0438\u0433\u0440\u043E\u043A\u0430 \u0432
      \u043D\u0430\u0447\u0430\u043B\u0435 \u0445\u043E\u0434\u0430 \u043D\u0435
