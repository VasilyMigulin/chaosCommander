  - m_Id: 6726057653690380
    m_Localized: "Looking for someone to punch\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690381
    m_Localized: "Scouting for an easy mark\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690382
    m_Localized: "Setting up the showdown\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690383
    m_Localized: "Cracking our knuckles\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690384
    m_Localized: "Charging up the good vibes\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690385
    m_Localized: "Scanning the servers for victims\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690386
    m_Localized: "Just hanging around\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690387
    m_Localized: "Matching by intellect\u2026 lowering the bar"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690388
    m_Localized: "Looking for a worthy foe\u2026 or literally anyone"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690389
    m_Localized: "Waiting for a brave soul\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690390
    m_Localized: "Combing the server's back alleys\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690391
    m_Localized: "Sharpening our claws\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690392
    m_Localized: "Warming up our fists\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690393
    m_Localized: "Packing extra swagger\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690394
    m_Localized: "Seeking a rival with big dreams and no chance\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690395
    m_Localized: "Preparing excuses in case you lose\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690396
    m_Localized: "Recruiting a volunteer for the loser role\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690397
    m_Localized: "Someone has to lose\u2026 and it won't be us"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690398
    m_Localized: "Looking for someone who won't chicken out\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690399
    m_Localized: "Calling everyone out\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690400
    m_Localized: "Prepping the arena for a beatdown\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690401
    m_Localized: "Victim wanted \u2014 apply within\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690402
    m_Localized: "Betting your ego on this one\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690403
    m_Localized: "Warming up the bench of chumps\u2026"
