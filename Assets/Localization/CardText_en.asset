      m_Items: []
  - m_Id: 6726057653690404
    m_Localized: "Checking the server for brave souls\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690405
    m_Localized: "Finding an opponent\u2026 maybe luck skips you today"
