      m_Items: []
  - m_Id: 6726057653690413
    m_Localized: "Finding someone who still believes in their deck\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6726057653690414
    m_Localized: "Pouring your rival a glass of false hope\u2026"
