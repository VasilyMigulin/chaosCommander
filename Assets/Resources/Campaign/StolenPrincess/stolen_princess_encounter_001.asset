  IntroLines:
  - Portrait: {fileID: 21300000, guid: 049d1403ca0954c6e8c805419a41f803, type: 3}
    SpeakerKey: story.guard.name
    TextKey: story.c1e1.intro.1
    FallbackText: "\u0421\u0442\u0440\u0430\u0436\u0430! \u042F, \u0428\u0430\u043B\u044C\u043D\u043E\u0439
      \u043F\u0440\u0438\u043D\u0446, \u0442\u0440\u0435\u0431\u0443\u044E \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u043C\u0435\u043D\u044F. \u2026\u0410\u0445, \u0432\u044B \u0438 \u0435\u0441\u0442\u044C
      \u0441\u0442\u0440\u0430\u0436\u0430."
    Duration: 3.5
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e1.intro.2
    FallbackText: "\u041D\u0443 \u0445\u043E\u0442\u044C \u0440\u0430\u0437\u043E\u043C\u043D\u0451\u043C\u0441\u044F
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0435\u043C
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B."
    Duration: 3.5
  VictoryLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e1.victory.1
    FallbackText: "\u041F\u043E\u0431\u0435\u0433 \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u043D!
      \u0417\u0430\u043C\u043E\u043A, \u0442\u044B \u0431\u044B\u043B \u0442\u0430\u043A
      \u0441\u0435\u0431\u0435."
    Duration: 3.5
  DefeatLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e1.defeat.1
    FallbackText: "\u041E\u0431\u0440\u0430\u0442\u043D\u043E \u0432 \u043A\u0430\u043C\u0435\u0440\u0443.
      \u0422\u0430\u043C \u0445\u043E\u0442\u044F \u0431\u044B \u043A\u043E\u0440\u043C\u044F\u0442."
