  IntroLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e5.intro.1
    FallbackText: "\u041F\u0440\u0435\u0438\u0441\u043F\u043E\u0434\u043D\u044F\u044F.
      \u0422\u0435\u043F\u043B\u043E, \u043B\u044E\u0434\u043D\u043E, \u043D\u0430\u0447\u0430\u043B\u044C\u0441\u0442\u0432\u043E.
      \u041A\u0430\u043A \u043F\u043E\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A."
    Duration: 3.5
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e5.intro.2
    FallbackText: "\u0422\u044B \u043D\u0435 \u0413\u043D\u0438\u0434\u0430\u043B\u044C\u0444.
      \u0422\u044B \u0435\u0433\u043E \u043F\u043E\u0434\u0440\u044F\u0434\u0447\u0438\u043A."
    Duration: 3.5
  VictoryLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e5.victory.1
    FallbackText: "\u041F\u0435\u0440\u0435\u0434\u0430\u0439 \u043D\u0430\u0432\u0435\u0440\u0445:
      \u043F\u0440\u0438\u043D\u0446 \u0443\u0436\u0435 \u0432 \u043F\u0443\u0442\u0438.
      \u0418 \u043E\u043D \u0437\u043E\u043B."
    Duration: 3.5
  DefeatLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e5.defeat.1
    FallbackText: "\u041C\u0435\u043D\u044F \u0437\u0430\u043A\u0438\u0434\u0430\u043B\u0438
      \u0447\u0435\u0440\u0442\u044F\u043C\u0438. \u041C\u0435\u043B\u043A\u0438\u043C\u0438.
      \u041E\u0431\u0438\u0434\u043D\u043E \u0432\u0434\u0432\u043E\u0439\u043D\u0435."
    Duration: 3.5
