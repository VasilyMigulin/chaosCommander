  IntroLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e3.intro.1
    FallbackText: "\u041A\u0430\u0447\u0430\u043B\u043A\u0430? \u041E\u0442\u043B\u0438\u0447\u043D\u043E,
      \u0441\u043F\u0440\u043E\u0448\u0443 \u0434\u043E\u0440\u043E\u0433\u0443.
      \u2026\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u0441\u0435 \u0442\u0430\u043A\u0438\u0435
      \u0431\u043E\u043B\u044C\u0448\u0438\u0435?"
    Duration: 3.5
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e3.intro.2
    FallbackText: "\u0411\u0438\u043B\u043B\u0438, \u044F \u043D\u0435 \u0445\u043E\u0447\u0443
      \u0441 \u0442\u043E\u0431\u043E\u0439 \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u0442\u044C\u0441\u044F.
      \u042F \u0445\u043E\u0447\u0443 \u043C\u0438\u043C\u043E \u0442\u0435\u0431\u044F
      \u043F\u0440\u043E\u0439\u0442\u0438."
    Duration: 3.5
  VictoryLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e3.victory.1
    FallbackText: "\u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0437\u0430
      \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0443. \u0411\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043F\u0440\u0438\u0434\u0443."
    Duration: 3.5
  DefeatLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e3.defeat.1
    FallbackText: "\u041C\u0435\u043D\u044F \u0437\u0430\u0436\u0430\u043B\u0438.
      \u0418 \u044D\u0442\u043E \u0431\u044B\u043B \u043D\u0435 \u043F\u0440\u0438\u0451\u043C."
    Duration: 3.5
