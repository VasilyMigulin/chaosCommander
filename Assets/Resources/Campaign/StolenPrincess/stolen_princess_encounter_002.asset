  IntroLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e2.intro.1
    FallbackText: "\u0424\u0443. \u041A\u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F.
      \u041F\u0430\u0445\u043D\u0435\u0442 \u043A\u0430\u043A \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u043F\u043E \u0445\u0438\u043C\u0438\u0438."
    Duration: 3.5
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e2.intro.2
    FallbackText: "\u041A\u0440\u044B\u0441\u0438\u043D\u044B\u0439 \u043A\u043E\u0440\u043E\u043B\u044C?
      \u0421\u0435\u0440\u044C\u0451\u0437\u043D\u043E? \u0423 \u043C\u0435\u043D\u044F
      \u0430\u043B\u043B\u0435\u0440\u0433\u0438\u044F \u043D\u0430 \u043C\u043E\u043D\u0430\u0440\u0445\u043E\u0432."
    Duration: 3.5
  VictoryLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e2.victory.1
    FallbackText: "\u0414\u043E\u043B\u0433\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u0438
      \u0442\u0432\u043E\u0438\u043C \u043A\u0440\u044B\u0441\u0430\u043C. \u041E\u0447\u0435\u043D\u044C
      \u0434\u043E\u043B\u0433\u043E\u0439 \u2014 \u043E\u043D\u0438 \u0432\u0441\u0451
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F."
    Duration: 3.5
  DefeatLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e2.defeat.1
    FallbackText: "\u041C\u0435\u043D\u044F \u0437\u0430\u0433\u0440\u044B\u0437\u043B\u0438.
      \u0411\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E. \u041A\u0430\u043A
      \u043D\u0435\u043B\u043E\u0432\u043A\u043E."
    Duration: 3.5
