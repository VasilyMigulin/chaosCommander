  PlayerDeck: {fileID: 11400000, guid: 1f7794b399a256f881b00b03b1378373, type: 2}
  IntroLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e6.intro.1
    FallbackText: "\u0413\u043D\u0438\u0434\u0430\u043B\u044C\u0444! \u041E\u0442\u043F\u0443\u0441\u0442\u0438
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0443, \u043D\u0435\u043C\u044B\u0442\u0430\u044F
      \u0442\u044B \u0434\u0443\u0448\u0430!"
    Duration: 3.5
  - Portrait: {fileID: 21300000, guid: 9f35db904975f48b9b6673de8a13d323, type: 3}
    SpeakerKey: story.gnidalf.name
    TextKey: story.c1e6.intro.2
    FallbackText: "\u041C\u044B\u043B\u0441\u044F \u044F \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C
      \u0432\u0435\u043A\u0435. \u0418 \u043F\u043E\u0431\u0435\u0434\u0438\u043B
      \u0442\u043E\u0436\u0435 \u2014 \u0437\u0430\u0440\u0430\u043D\u0435\u0435."
    Duration: 3.5
  VictoryLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e6.victory.1
    FallbackText: "\u0413\u043E\u0442\u043E\u0432\u043E. \u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430, \u0430 \u0413\u043D\u0438\u0434\u0430\u043B\u044C\u0444
      \u2014 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E \u043D\u0435\u043C\u044B\u0442."
    Duration: 3.5
  - Portrait: {fileID: 21300000, guid: b3eea32e56c034e73a8f2aeb84e0462e, type: 3}
    SpeakerKey: story.princess.name
    TextKey: story.c1e6.victory.2
    FallbackText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u043F\u0440\u0438\u043D\u0446.
      \u041E\u0442 \u0442\u0435\u0431\u044F, \u043A\u0441\u0442\u0430\u0442\u0438,
      \u0442\u043E\u0436\u0435\u2026 \u043D\u0443, \u043F\u043E\u0442\u043E\u043C
      \u043F\u043E\u043C\u043E\u0435\u0448\u044C\u0441\u044F."
    Duration: 3.5
  DefeatLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e6.defeat.1
    FallbackText: "\u041F\u043E\u0447\u0442\u0438. \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u0437\u0430\u0445\u0432\u0430\u0447\u0443 \u043C\u044B\u043B\u043E
      \u2014 \u0432\u0434\u0440\u0443\u0433 \u043F\u043E\u043C\u043E\u0436\u0435\u0442."
    Duration: 3.5
  ScriptedEvents:
  - Note: "\u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 \u0444\u0438\u043D\u0430\u043B\u0430
      \u2014 \u0413\u043D\u0438\u0434\u0430\u043B\u044C\u0444 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
      \u0412\u043E\u043D\u044E\u0447\u0438\u0435 \u043E\u0431\u043B\u0430\u043A\u0430
      \u0432 \u043A\u043E\u043B\u043E\u0434\u0443 \u0438\u0433\u0440\u043E\u043A\u0430"
    Trigger: 0
    TurnNumber: 1
    HpThreshold: 0
    Lines:
    - Portrait: {fileID: 21300000, guid: 9f35db904975f48b9b6673de8a13d323, type: 3}
      SpeakerKey: story.gnidalf.name
      TextKey: story.c1e6.event.1
      FallbackText: "\u0414\u043B\u044F \u043D\u0435\u043F\u043B\u043E\u0445\u043E\u0433\u043E
        \u0441\u0442\u0430\u0440\u0442\u0430, \u0434\u0435\u0440\u0436\u0438!"
      Duration: 3.5
    Actions:
    - Kind: 0
      Card: {fileID: 11400000, guid: 33f54471ec41a3240b3e53008c0c944f, type: 2}
      Amount: 3
      TargetPlayer: 1
  - Note: 
    Trigger: 0
    TurnNumber: 5
    HpThreshold: 0
