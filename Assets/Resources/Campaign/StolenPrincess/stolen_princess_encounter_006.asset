      SpeakerKey: story.gnidalf.name
      TextKey: story.c1e6.event.2
      FallbackText: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E
        \u044F \u0432\u0447\u0435\u0440\u0430 \u0441\u044A\u0435\u043B \u0447\u0442\u043E-\u0442\u043E
        \u043D\u0435 \u0442\u043E!"
      Duration: 3.6
