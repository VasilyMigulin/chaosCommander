  m_EditorClassIdentifier: Game.Core.Configs::Game.Core.Configs.PveEncounterConfig
  EncounterName: "\u0413\u043D\u0438\u0434\u0430\u043B\u044C\u0444 \u043D\u0435\u043C\u044B\u0442\u044B\u0439"
  Commander: {fileID: 11400000, guid: ef3314653b76bac4681ec8748794092e, type: 2}
