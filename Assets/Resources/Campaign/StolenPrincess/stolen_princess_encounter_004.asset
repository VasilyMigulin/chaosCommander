  m_EditorClassIdentifier: Game.Core.Configs::Game.Core.Configs.PveEncounterConfig
  EncounterName: "\u041A\u043E\u043B\u0434\u0443\u043D \u041F\u043B\u0435\u0441\u043D\u0435\u0432\u0438\u043A"
  Commander: {fileID: 11400000, guid: f347c1dd11ad5f9c8a13a64946ea4b07, type: 2}
  Cards:
  - Card: {fileID: 11400000, guid: a0e0327014bf8624baf150cbf48f6c44, type: 2}
    Count: 4
  - Card: {fileID: 11400000, guid: 13170f148c767f24186c4977f01a3196, type: 2}
