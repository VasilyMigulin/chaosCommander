  - Card: {fileID: 11400000, guid: 1979eed322125444b9e336df4e9d515f, type: 2}
    Count: 4
  StartingHand: 4
  Health: 25
  PlayerDeck: {fileID: 11400000, guid: d0213825926dc29b64bad77ef25a6f58, type: 2}
  IntroLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e4.intro.1
    FallbackText: "\u0411\u043E\u043B\u043E\u0442\u043E \u043D\u0435\u0432\u0435\u0437\u0435\u043D\u0438\u044F.
      \u041F\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044E \u0443\u0436\u0435
      \u043F\u043E\u043D\u044F\u0442\u043D\u043E, \u0447\u0435\u043C \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F."
    Duration: 3.5
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e4.intro.2
    FallbackText: "\u0414\u0435\u0434, \u043E\u0442\u0434\u0430\u0439 \u043F\u043E\u0441\u043E\u0445.
      \u041E\u043D \u0442\u0435\u0431\u0435 \u0432\u0435\u043B\u0438\u043A\u043E\u0432\u0430\u0442."
    Duration: 3.5
  VictoryLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e4.victory.1
    FallbackText: "\u041F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u044F \u0441\u043D\u044F\u0442\u044B.
      \u041D\u0435\u0432\u0435\u0437\u0435\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C,
      \u043D\u043E \u044D\u0442\u043E \u0443\u0436\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440."
    Duration: 3.5
  DefeatLines:
  - Portrait: {fileID: 21300000, guid: ea0d15c8ad5814d68ba5d1f53bae6247, type: 3}
    SpeakerKey: story.prince.name
    TextKey: story.c1e4.defeat.1
    FallbackText: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u0432\u044B\u0442\u044F\u043D\u0443\u043B
      \u043D\u0435 \u0442\u0443 \u043A\u0430\u0440\u0442\u0443. \u0412\u0441\u0435
      \u043D\u0435 \u0442\u0435."
    Duration: 3.5
  ScriptedEvents:
  - Note: "\u0422\u0438\u0437\u0435\u0440 \u0444\u0438\u043D\u0430\u043B\u0430 \u2014
      \u0413\u043D\u0438\u0434\u0430\u043B\u044C\u0444 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043C\u0435\u0448\u0430\u0435\u0442 \u0438\u0433\u0440\u043E\u043A\u0443
      \u0412\u043E\u043D\u044E\u0447\u0438\u0435 \u043E\u0431\u043B\u0430\u043A\u0430"
    Trigger: 0
    TurnNumber: 4
    HpThreshold: 0
    Lines:
    - Portrait: {fileID: 21300000, guid: 9f35db904975f48b9b6673de8a13d323, type: 3}
      SpeakerKey: story.gnidalf.name
      TextKey: story.c1e4.event.1
      FallbackText: "\u041A\u0443-\u043A\u0443, \u043F\u0440\u0438\u043D\u0446. \u0414\u0435\u0440\u0436\u0438
        \u0433\u043E\u0441\u0442\u0438\u043D\u0435\u0446 \u2014 \u043F\u043E\u0434\u044B\u0448\u0438\u0448\u044C
        \u043C\u043E\u0438\u043C\u0438 \u043E\u0431\u043B\u0430\u0447\u043A\u0430\u043C\u0438."
      Duration: 3.5
